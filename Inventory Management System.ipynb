   "source": [
    "def rotate_left(arr, k):\n",
    "    n = len(arr)\n",
    "    \n",
    "    if n == 0:\n",
    "        return arr\n",
    "    \n",
    "    k = k % n\n",
    "    return arr[k:] + arr[:k]"
   ]
